APP_ENV=development
DATABASE_URL=postgresql+psycopg://brahmaai:replace-this-password@localhost:5432/brahmaai
SESSION_COOKIE_NAME=bas_session
SESSION_TTL_HOURS=24
SECURE_COOKIES=false
CORS_ORIGINS=http://localhost:3000

# Optional local Ollama-compatible model gateway (no cloud fallback)
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
# Set to an already-installed model name, e.g. qwen2.5:7b
# LOCAL_LLM_MODEL=qwen2.5:7b
LOCAL_LLM_CONNECT_TIMEOUT_SECONDS=3
LOCAL_LLM_READ_TIMEOUT_SECONDS=45
LOCAL_LLM_MAX_RESPONSE_BYTES=1000000
LOCAL_LLM_MAX_HISTORY_MESSAGES=12
LOCAL_LLM_MAX_HISTORY_CHARACTERS=12000
